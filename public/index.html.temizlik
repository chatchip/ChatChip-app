<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatChip</title>
    <meta name="theme-color" content="#7BD3C9">
    <link rel="manifest" href="/manifest.json">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
    <div class="app-container">
        <!-- SOL MENÜ -->
        <div class="sidebar-left" id="sidebarLeft">
            <div class="sidebar-header">
                <div class="logo">
                    <img src="/assets/logo.svg" alt="ChatChip" width="28" height="28">
                    <span>ChatChip</span>
                </div>
                <button class="close-sidebar" onclick="toggleSidebar('left')">✕</button>
            </div>
            
            <button class="new-chat-btn" onclick="startNewChat()">➕ Yeni Sohbet</button>
            
            <div class="chat-history" id="chatHistory">
                <div style="text-align:center; padding:20px; color:var(--text-light); font-size:0.8rem;">
                    Henüz sohbet yok
                </div>
            </div>
            
            <div class="search-chat">
                <input type="text" id="searchChatInput" placeholder="🔍 Sohbetlerde ara..." oninput="searchChats()">
            </div>
            
            <div class="sidebar-footer">
                <button class="sidebar-btn" onclick="startNewChat()" style="background:var(--primary); color:white; border:none; width:100%; padding:10px; border-radius:8px; font-weight:600; cursor:pointer;">
                    ➕ Yeni Sohbet
                </button>
            </div>
        </div>

        <!-- ANA İÇERİK -->
        <div class="main-content">
            <header class="header" style="display:flex; align-items:center; justify-content:space-between; padding:8px 16px; border-bottom:1px solid var(--border); background:var(--bg-secondary); flex-shrink:0;">
                <button id="menuToggle" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text); padding:4px 8px;">
                    ☰
                </button>

                <div style="display:flex; align-items:center; gap:16px; flex:1; justify-content:center;">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <span style="font-size:0.75rem; font-weight:600; color:var(--text-light);">Model</span>
                        <select id="modelSelector" style="padding:4px 10px; border-radius:6px; border:1px solid var(--border); background:var(--bg); color:var(--text); font-size:0.75rem; cursor:pointer; outline:none;">
                            <option value="1.0">ChatChip 1.0</option>
                            <option value="2.0">ChatChip 2.0</option>
                            <option value="2.1">ChatChip 2.1</option>
                        </select>
                    </div>

                    <div style="display:flex; align-items:center; gap:6px; border-left:1px solid var(--border); padding-left:16px;">
                        <span style="font-size:0.75rem; font-weight:600; color:var(--text-light);">Coach</span>
                        <select id="coachSelector" style="padding:4px 10px; border-radius:6px; border:1px solid var(--border); background:var(--bg); color:var(--text); font-size:0.75rem; cursor:pointer; outline:none;">
                            <option value="standard">Normal</option>
                            <option value="mlm">MLM Koçu</option>
                            <option value="akademi">Akademik Koç</option>
                            <option value="kisisel">Kişisel Koç</option>
                        </select>
                    </div>
                </div>

                <button id="profileToggle" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text); padding:4px 8px;">
                    👤
                </button>
            </header>

            <div id="planWarning" style="display:none; background:#FEF3C7; padding:8px 16px; text-align:center; font-size:0.8rem; color:#92400E; border-bottom:1px solid #F59E0B;">
                ⚠️ <strong>Planınız sona erdi!</strong> 
                <a href="/pricing.html" style="color:#d97706; text-decoration:underline;">Hemen plan satın alın</a>
            </div>

            <main class="chat-area" id="chatArea">
                <div class="welcome">
                    <h2 id="welcomeMessage">Merhaba! 👋</h2>
                    <p>Bugün sana nasıl yardımcı olabilirim?</p>
                </div>
                <div id="messages"></div>
            </main>

            <footer class="input-area">
                <div class="input-wrapper">
                    <textarea id="messageInput" rows="1" placeholder="Mesajını yaz..."></textarea>
                    <button id="sendBtn">➤</button>
                </div>
            </footer>
        </div>

        <!-- SAĞ PROFİL - MODERN VERSİYON -->
        <div class="sidebar-right" id="sidebarRight">
            <div class="sidebar-header">
                <div class="logo">
                    <img src="/assets/logo.svg" alt="ChatChip" width="28" height="28">
                    <span>Hesap</span>
                </div>
                <button class="close-sidebar" onclick="toggleSidebar('right')">✕</button>
            </div>

            <div class="profile-section" id="profileSection">
                <div class="profile-avatar" id="profileAvatar">👤</div>
                <div class="profile-name" id="profileName">Misafir</div>
                <div class="profile-email" id="profileEmail">giris@yapilmadi</div>
                <div class="profile-plan" id="profilePlan">
                    <span class="plan-label">📋 Plan</span>
                    <span class="plan-name" id="planName">🆓 Ücretsiz</span>
                    <span class="plan-time" id="planTime">24 saat kaldı</span>
                    <div id="planExpiresContainer" style="margin-top:4px; font-size:0.6rem; color:var(--text-light);">
                        🗓️ <span id="planExpires">Yükleniyor...</span>
                    </div>
                </div>
            </div>

            <div class="login-form" id="loginForm">
                <input type="email" id="loginEmail" class="form-input" placeholder="E-posta adresiniz">
                <input type="password" id="loginPassword" class="form-input" placeholder="Şifreniz">
                <button class="login-btn" id="loginBtn">🔑 Giriş Yap</button>
                <div style="text-align:center; margin-top:10px;">
                    <a href="/forgot-password.html" style="color:var(--text-light); font-size:0.75rem; text-decoration:none;">🔑 Şifremi Unuttum</a>
                    <span style="color:var(--text-light); font-size:0.75rem; margin:0 6px;">|</span>
                    <a href="/register?position=left" style="color:var(--primary); font-size:0.75rem; text-decoration:none;">Kayıt ol</a>
                </div>
            </div>

            <div class="user-menu" id="userMenu" style="display:none;">
                <button class="menu-item" onclick="window.location.href='/backoffice.html'">
                    <span class="icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></span>
                    <span class="label">Backoffice</span>
                    <span class="arrow">→</span>
                </button>
                <button class="menu-item" onclick="window.location.href='/cuzdan.html'">
                    <span class="icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M12 6v12" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M9 9l3-3 3 3M9 15l3 3 3-3" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></span>
                    <span class="label">Cüzdan</span>
                    <span class="arrow">→</span>
                </button>
                <button class="menu-item" onclick="window.location.href='/tree-detail.html'">
                    <span class="icon"><svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M2 17l10 5 10-5" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></span>
                    <span class="label">Ağaç</span>
                    <span class="arrow">→</span>
                </button>
                <button class="menu-item" onclick="window.location.href='/pricing.html'">
                    <span class="icon"><svg viewBox="0 0 24 24"><path d="M12 3v18" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M5 10l7-7 7 7" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></span>
                    <span class="label">Plan Yükselt</span>
                    <span class="arrow">→</span>
                </button>
                <button class="menu-item admin" id="adminMenuItem" style="display:none;" onclick="window.location.href='/admin-panel.html'">
                    <span class="icon"><svg viewBox="0 0 24 24"><path d="M2 20l2-12h16l2 12H2z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M7 8l2-4 3 2 3-2 2 4" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></span>
                    <span class="label">Admin Panel</span>
                    <span class="arrow">→</span>
                </button>

                <div style="margin:8px 0;">
                    <button class="menu-item theme-toggle" onclick="toggleDarkMode()">
                        <span id="themeIcon" style="font-size:1rem;">🌓</span> Tema Değiştir
                    </button>
                </div>

                <div class="prompt-item">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;"><span class="prompt-label" style="margin:0;">📝 Sistem Promptu</span><button onclick="saveSystemPrompt()" style="padding:2px 12px; border-radius:6px; border:none; background:var(--primary); color:white; font-size:0.6rem; cursor:pointer;">Kaydet</button></div>
                    <textarea id="systemPromptInput" rows="2" placeholder="AI'nın yanıt stilini belirleyin..."></textarea>
                    <button onclick="saveSystemPrompt()">Kaydet</button>
                </div>

                <button class="menu-item logout" id="logoutBtn">
                    <span class="icon"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" stroke="currentColor" stroke-width="1.6" fill="none"/><polyline points="16 17 21 12 16 7" stroke="currentColor" stroke-width="1.6" fill="none"/><line x1="21" y1="12" x2="9" y2="12" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></span>
                    <span class="label">Oturumu Kapat</span>
                </button>
            </div>
        </div>

        <div class="overlay" id="overlay" onclick="closeAllSidebars()"></div>
    </div>

    <script src="/js/datamanager.js"></script>
    <script src="/js/sidebar.js"></script>
    <script src="/js/app.js"></script>
    <script>
        // 🔥 Butonları manuel olarak bağla
        document.addEventListener('DOMContentLoaded', function() {
            const menuBtn = document.getElementById('menuToggle');
            const profileBtn = document.getElementById('profileToggle');
            
            if (menuBtn) {
                menuBtn.addEventListener('click', function() {
                    toggleSidebar('left');
                });
            }
            
            if (profileBtn) {
                profileBtn.addEventListener('click', function() {
                    toggleSidebar('right');
                });
            }
        });
    </script>
</body>
</html>
