{
    admin off
    persist_config off
    auto_https off
    log {
        format json
    }
    servers {
        trusted_proxies static 0.0.0.0/0 ::/0
    }
}

:{$PORT:8080} {
    log {
        format json
    }

    root * public
    encode gzip

    # Public AI Employee clean URLs: /l/<slug>
    @aiEmployee path /l/*
    handle @aiEmployee {
        try_files {path} /l/index.html
        file_server
    }

    # All existing ChatChip static pages/assets keep their current behavior.
    handle {
        file_server
    }
}
