<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatChip</title>
    <meta name="theme-color" content="#7BD3C9">
    <link rel="manifest" href="/manifest.json">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
    <div class="app-container">
        <!-- SOL MENÜ -->
        <div class="sidebar-left" id="sidebarLeft">
            <div class="sidebar-header">
                <div class="logo">
                    <img src="/assets/logo.svg" alt="ChatChip" width="28" height="28">
                    <span>ChatChip</span>
                </div>
                <button class="close-sidebar" onclick="toggleSidebar('left')">✕</button>
            </div>
            <button class="new-chat-btn" onclick="startNewChat()">➕ Yeni Sohbet</button>
            <div class="chat-history" id="chatHistory">
                <div style="text-align:center; padding:20px; color:var(--text-light); font-size:0.8rem;">Henüz sohbet yok</div>
            </div>
            <div class="search-chat">
                <input type="text" id="searchChatInput" placeholder="🔍 Sohbetlerde ara..." oninput="searchChats()">
            </div>
            <div class="sidebar-footer">
                <button class="sidebar-btn" onclick="startNewChat()" style="background:var(--primary); color:white; border:none; width:100%; padding:10px; border-radius:8px; font-weight:600; cursor:pointer;">➕ Yeni Sohbet</button>
            </div>
        </div>

        <!-- ANA İÇERİK -->
        <div class="main-content">
            <header class="header" style="display:flex; align-items:center; justify-content:space-between; padding:8px 16px; border-bottom:1px solid var(--border); background:var(--bg-secondary); flex-shrink:0;">
                <button id="menuToggle" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text); padding:4px 8px;">☰</button>

                <div style="display:flex; align-items:center; gap:16px; flex:1; justify-content:center;">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <span style="font-size:0.75rem; font-weight:600; color:var(--text-light);">Versiyon</span>
                        <span id="versionDisplay" style="font-size:0.8rem; font-weight:600; color:var(--primary);">ChatChip 1.0</span>
                    </div>
                    <div style="display:flex; align-items:center; gap:6px; border-left:1px solid var(--border); padding-left:16px;">
                        <span style="font-size:0.75rem; font-weight:600; color:var(--text-light);">Coach</span>
                        <select id="coachSelector" style="padding:4px 10px; border-radius:6px; border:1px solid var(--border); background:var(--bg); color:var(--text); font-size:0.75rem; cursor:pointer; outline:none;">
                            <option value="standard" selected>Normal</option>
                            <option value="mlm">MLM Koçu</option>
                            <option value="akademi">Akademik Koç</option>
                            <option value="kisisel">Kişisel Koç</option>
                        </select>
                    </div>
                </div>

                <button id="profileToggle" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text); padding:4px 8px;">👤</button>
            </header>

            <div id="planWarning" style="display:none; background:#FEF3C7; padding:8px 16px; text-align:center; font-size:0.8rem; color:#92400E; border-bottom:1px solid #F59E0B;">
                ⚠️ <strong>Planınız sona erdi!</strong> <a href="/pricing.html" style="color:#d97706; text-decoration:underline;">Hemen plan satın alın</a>
            </div>

            <main class="chat-area" id="chatArea">
                <div class="welcome">
                    <h2 id="welcomeMessage">Merhaba! 👋</h2>
                    <p>Bugün sana nasıl yardımcı olabilirim?</p>
                </div>
                <div id="messages"></div>
            </main>

            <footer class="input-area">
                <div class="input-wrapper">
                    <button id="fileUploadBtn" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text-light); padding:4px 6px;" title="Dosya Yükle">📎</button>
                    <input type="file" id="fileInput" style="display:none;" accept=".txt,.pdf,.docx,.png,.jpg,.jpeg,.gif,.webp">
                    
                    <button id="imageBtn" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text-light); padding:4px 6px;" title="Görsel Üret">🎨</button>
                    
                    <textarea id="messageInput" rows="1" placeholder="Mesajını yaz..."></textarea>
                    
                    <button id="speechBtn" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--text-light); padding:4px 6px;" title="Sesli Komut">🎤</button>
                    
                    <!-- ⏹ Yanıtı Durdur Butonu (GÖRÜNÜR) -->
                    <button id="stopBtn" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:#EF4444; padding:4px 6px;" title="Yanıtı Durdur">⏹</button>
                    
                    <button id="sendBtn">➤</button>
                </div>
            </footer>
        </div>

        <!-- SAĞ PROFİL -->
        <div class="sidebar-right" id="sidebarRight">
            <div class="sidebar-header">
                <div class="logo">
                    <img src="/assets/logo.svg" alt="ChatChip" width="28" height="28">
                    <span>Hesap</span>
                </div>
                <button class="close-sidebar" onclick="toggleSidebar('right')">✕</button>
            </div>

            <div class="profile-section" id="profileSection">
                <div class="profile-avatar" id="profileAvatar">👤</div>
                <div class="profile-name" id="profileName">Misafir</div>
                <div class="profile-email" id="profileEmail">giris@yapilmadi</div>
                <div class="profile-plan" id="profilePlan">
                    <span class="plan-label">📋 Plan</span>
                    <span class="plan-name" id="planName">🆓 Ücretsiz</span>
                    <span class="plan-time" id="planTime">24 saat kaldı</span>
                    <div id="planExpiresContainer" style="margin-top:4px; font-size:0.6rem; color:var(--text-light);">🗓️ <span id="planExpires">Yükleniyor...</span></div>
                </div>
            </div>

            <div class="login-form" id="loginForm">
                <input type="email" id="loginEmail" class="form-input" placeholder="E-posta adresiniz">
                <input type="password" id="loginPassword" class="form-input" placeholder="Şifreniz">
                <button class="login-btn" id="loginBtn">🔑 Giriş Yap</button>
                <div style="text-align:center; margin-top:10px;">
                    <a href="/forgot-password.html" style="color:var(--text-light); font-size:0.75rem; text-decoration:none;">🔑 Şifremi Unuttum</a>
                    <span style="color:var(--text-light); font-size:0.75rem; margin:0 6px;">|</span>
                    <a href="/register?position=left" style="color:var(--primary); font-size:0.75rem; text-decoration:none;">Kayıt ol</a>
                </div>
            </div>

            <div class="user-menu" id="userMenu" style="display:none;">
                <button class="menu-item" onclick="window.location.href='/backoffice.html'">📊 Backoffice</button>
                <button class="menu-item" onclick="window.location.href='/cuzdan.html'">💰 Cüzdan</button>
                <button class="menu-item" onclick="window.location.href='/tree-detail.html'">🌳 Ağaç</button>
                <button class="menu-item" onclick="window.location.href='/pricing.html'">⬆️ Plan Yükselt</button>
                <button class="menu-item admin" id="adminMenuItem" style="display:none;" onclick="window.location.href='/admin-panel.html'">👑 Admin Panel</button>
                <div style="margin:8px 0;">
                    <button class="menu-item theme-toggle" onclick="toggleDarkMode()">🌓 Tema Değiştir</button>
                </div>
                <div class="prompt-item">
                    <span class="prompt-label">📝 Sistem Promptu</span>
                    <textarea id="systemPromptInput" rows="2" placeholder="AI'nın yanıt stilini belirleyin..."></textarea>
                    <button onclick="saveSystemPrompt()">Kaydet</button>
                </div>
                <button class="menu-item logout" id="logoutBtn">🚪 Oturumu Kapat</button>
            </div>
        </div>

        <div class="overlay" id="overlay" onclick="closeAllSidebars()"></div>
    </div>

    <script src="/js/datamanager.js"></script>
    <script src="/js/sidebar.js"></script>
    <script src="/js/app.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('menuToggle').addEventListener('click', function() { toggleSidebar('left'); });
            document.getElementById('profileToggle').addEventListener('click', function() { toggleSidebar('right'); });
        });
    </script>
</body>
</html>
